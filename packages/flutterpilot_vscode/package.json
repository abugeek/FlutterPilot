{
  "name": "flutterpilot-vscode",
  "displayName": "FlutterPilot",
  "description": "AI-native runtime introspection and active control for Flutter.",
  "version": "0.1.0",
  "publisher": "flutterpilot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abugeek/FlutterPilot"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterpilot.startServer",
        "title": "FlutterPilot: Start MCP Server",
        "category": "FlutterPilot"
      },
      {
        "command": "flutterpilot.captureScreenshot",
        "title": "FlutterPilot: Capture Screenshot",
        "category": "FlutterPilot"
      },
      {
        "command": "flutterpilot.openDashboard",
        "title": "FlutterPilot: Open Dashboard",
        "category": "FlutterPilot"
      }
    ],
    "configuration": {
      "title": "FlutterPilot",
      "properties": {
        "flutterpilot.serverPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the flutterpilot_server executable. Leave empty to use the default (dart run)."
        },
        "flutterpilot.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the MCP server when a Flutter debug session begins."
        },
        "flutterpilot.logLevel": {
          "type": "string",
          "default": "info",
          "enum": ["fine", "info", "warning", "severe"],
          "description": "Log level for the MCP server output."
        },
        "flutterpilot.dashboardRefreshInterval": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 30000,
          "description": "Dashboard auto-refresh interval in milliseconds."
        },
        "flutterpilot.allowDestructive": {
          "type": "boolean",
          "default": false,
          "description": "Allow non-SELECT database queries (INSERT, UPDATE, DELETE) via the Drift plugin."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flutterpilot-explorer",
          "title": "FlutterPilot",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flutterpilot-explorer": [
        {
          "id": "flutterpilot.dashboard",
          "name": "Dashboard",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "typescript": "^5.1.3",
    "@vscode/test-electron": "^2.3.2"
  }
}
